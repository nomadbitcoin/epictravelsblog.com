---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About Us - Epic Travels Blog"
  description="Learn about Epic Travels Blog — your source for epic travel destinations, guides, and tips for adventurers worldwide."
>
  <div class="py-12">
    <div class="container-custom max-w-4xl">
      <h1 class="text-4xl md:text-5xl font-bold mb-8">About Epic Travels Blog</h1>

      <div class="prose prose-lg max-w-none">
        <p class="text-xl text-gray-600 mb-8">
          We help travelers discover epic destinations, plan budget-friendly trips, and make the most of every adventure.
        </p>

        <h2>Our Mission</h2>
        <p>
          Epic Travels Blog is dedicated to providing honest, practical, and inspiring travel content
          for adventurers at every level — from weekend getaways to once-in-a-lifetime expeditions.
        </p>

        <h2>What We Cover</h2>
        <ul>
          <li>Destination guides and itineraries</li>
          <li>Budget travel tips and cheapest times to visit</li>
          <li>Solo travel safety and advice</li>
          <li>Weekend getaway ideas</li>
        </ul>

        <h2>Contact Us</h2>
        <p>
          Have a question or suggestion? We'd love to hear from you.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
